---
import Layout from '~/layouts/PageLayout.astro';
import {
  fetchGalleryEvents,
  fetchLocalResources,
  fetchNewsletters,
  fetchSocialLinks,
  fetchUpcomingEvents,
} from '~/utils/sanity';

const [upcomingEvents, galleryEvents, localResources, newsletters, socialLinks] = await Promise.all([
  fetchUpcomingEvents(),
  fetchGalleryEvents(),
  fetchLocalResources(),
  fetchNewsletters(),
  fetchSocialLinks(),
]);

const metadata = {
  title: 'Events',
};
---

<Layout metadata={metadata}>
  <main class="container mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold">Events</h1>

    <p class="mt-4 text-sm text-gray-600 dark:text-gray-300">Raw Sanity event data (test dump)</p>

    <div class="mt-8 space-y-8">
      <section>
        <h2 class="text-2xl font-semibold">Upcoming events</h2>
        <pre
          class="mt-3 max-h-[32rem] max-w-full overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-100 p-4 font-mono text-sm dark:bg-slate-900"><code>{JSON.stringify(upcomingEvents, null, 2)}</code></pre>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Gallery events</h2>
        <pre
          class="mt-3 max-h-[32rem] max-w-full overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-100 p-4 font-mono text-sm dark:bg-slate-900"><code>{JSON.stringify(galleryEvents, null, 2)}</code></pre>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Local resources</h2>
        <pre
          class="mt-3 max-h-[32rem] max-w-full overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-100 p-4 font-mono text-sm dark:bg-slate-900"><code>{JSON.stringify(localResources, null, 2)}</code></pre>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Newsletters</h2>
        <pre
          class="mt-3 max-h-[32rem] max-w-full overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-100 p-4 font-mono text-sm dark:bg-slate-900"><code>{JSON.stringify(newsletters, null, 2)}</code></pre>
      </section>

      <section>
        <h2 class="text-2xl font-semibold">Social links</h2>
        <pre
          class="mt-3 max-h-[32rem] max-w-full overflow-auto whitespace-pre-wrap break-words rounded-md bg-slate-100 p-4 font-mono text-sm dark:bg-slate-900"><code>{JSON.stringify(socialLinks, null, 2)}</code></pre>
      </section>
    </div>
  </main>
</Layout>
